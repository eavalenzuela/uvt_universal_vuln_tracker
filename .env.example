# UVT Docker Compose Environment
# Copy this file to .env and fill in real values before running docker compose.
#
# IMPORTANT: Never commit .env to version control.

# ---------------------------------------------------------------------------
# Flask / App
# ---------------------------------------------------------------------------
FLASK_ENV=development
SECRET_KEY=CHANGE-ME-to-a-random-string
JWT_SECRET=CHANGE-ME-to-a-random-string
FRONTEND_URL=http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Database (PostgreSQL; default is local SQLite if unset)
# ---------------------------------------------------------------------------
POSTGRES_USER=uvt_user
POSTGRES_PASSWORD=CHANGE-ME
POSTGRES_DB=uvt
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Connection pool (PostgreSQL only; SQLite ignores these)
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# ---------------------------------------------------------------------------
# Redis (rate limiting, caching, Celery)
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=redis

# Per-route rate limits (requests per window in seconds)
RATE_LIMIT_AUTH_LOGIN_LIMIT=5
RATE_LIMIT_AUTH_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_VULN_LIST_LIMIT=60
RATE_LIMIT_VULN_LIST_WINDOW_SECONDS=60
RATE_LIMIT_VULN_EXPORT_LIMIT=20
RATE_LIMIT_VULN_EXPORT_WINDOW_SECONDS=60
RATE_LIMIT_WRITE_LIMIT=30
RATE_LIMIT_WRITE_WINDOW_SECONDS=60
RATE_LIMIT_SENSITIVE_LIMIT=10
RATE_LIMIT_SENSITIVE_WINDOW_SECONDS=60
RATE_LIMIT_HEALTH_LIMIT=120
RATE_LIMIT_HEALTH_WINDOW_SECONDS=60

# ---------------------------------------------------------------------------
# Celery (background task queue)
# ---------------------------------------------------------------------------
CELERY_ENABLED=true
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_WORKER_CONCURRENCY=4
CELERY_TASK_TIMEOUT=3600
CELERY_TASK_SOFT_TIMEOUT=3300

# ---------------------------------------------------------------------------
# Caching (dashboard + products endpoints)
# ---------------------------------------------------------------------------
CACHE_ENABLED=false
CACHE_DASHBOARD_TTL=30
CACHE_PRODUCTS_TTL=60

# ---------------------------------------------------------------------------
# Data retention (days, 0 = keep forever)
# ---------------------------------------------------------------------------
RETENTION_AUDIT_LOG_DAYS=365
RETENTION_NOTIFICATION_LOG_DAYS=90
RETENTION_PLUGIN_RUN_DAYS=90
RETENTION_REPORT_ARTIFACT_DAYS=180

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Auth / Registration
# ---------------------------------------------------------------------------
ALLOW_PUBLIC_REGISTRATION=false
REFRESH_TOKEN_LIFETIME_DAYS=30
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=Lax
# AUTH_COOKIE_DOMAIN=example.com

# ---------------------------------------------------------------------------
# OIDC / SSO (optional)
# ---------------------------------------------------------------------------
OIDC_ENABLED=false
# OIDC_ISSUER=https://idp.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL=https://uvt.example.com/api/auth/oidc/callback
# OIDC_SCOPES=openid profile email
# OIDC_GROUPS_CLAIM=groups
# OIDC_DEFAULT_ROLE=Viewer
# OIDC_ROLE_MAPPING=security-admins:Admin,security-analysts:Analyst

# ---------------------------------------------------------------------------
# Plugins (comma-separated Python module paths for custom plugins)
# ---------------------------------------------------------------------------
PLUGIN_IMPORT_PATHS=
