# Example .env file

# App
FLASK_APP=backend.uvt_app:create_app
FLASK_ENV=development

# Secrets (dev only)
SECRET_KEY=dev-secret
JWT_SECRET=dev-jwt-secret

# Database (Postgres example)
DATABASE_URL=postgresql+psycopg://uvt_user:uvt_pass@localhost:5432/uvt
# Optional OIDC SSO
OIDC_ENABLED=false
OIDC_ISSUER=https://idp.example.com/realms/uvt
OIDC_CLIENT_ID=uvt-web
OIDC_CLIENT_SECRET=replace-me
OIDC_REDIRECT_URL=http://127.0.0.1:5000/api/auth/oidc/callback
OIDC_GROUPS_CLAIM=groups
OIDC_DEFAULT_ROLE=Viewer
OIDC_ROLE_MAPPING={"uvt-admins":"Admin","uvt-analysts":"Analyst","uvt-viewers":"Viewer"}
