# Example .env file

# App
FLASK_APP=backend.uvt_app:create_app
FLASK_ENV=development

# Secrets (dev only)
SECRET_KEY=dev-secret
JWT_SECRET=dev-jwt-secret

# Database (Postgres example)
DATABASE_URL=postgresql+psycopg://uvt_user:uvt_pass@localhost:5432/uvt
# Optional OIDC SSO
OIDC_ENABLED=false
OIDC_ISSUER=https://idp.example.com/realms/uvt
OIDC_CLIENT_ID=uvt-web
OIDC_CLIENT_SECRET=replace-me
OIDC_REDIRECT_URL=http://127.0.0.1:5000/api/auth/oidc/callback
OIDC_GROUPS_CLAIM=groups
OIDC_DEFAULT_ROLE=Viewer
OIDC_ROLE_MAPPING={"uvt-admins":"Admin","uvt-analysts":"Analyst","uvt-viewers":"Viewer"}

# Rate limiting
# In-memory backend is fine for single-process development.
# For production with multiple workers/processes, use the Redis backend
# to ensure rate limits are enforced consistently across all workers.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=memory
# RATE_LIMIT_BACKEND=redis
# REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_AUTH_LOGIN_LIMIT=5
RATE_LIMIT_AUTH_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_VULN_LIST_LIMIT=60
RATE_LIMIT_VULN_LIST_WINDOW_SECONDS=60
RATE_LIMIT_VULN_EXPORT_LIMIT=20
RATE_LIMIT_VULN_EXPORT_WINDOW_SECONDS=60
RATE_LIMIT_WRITE_LIMIT=30
RATE_LIMIT_WRITE_WINDOW_SECONDS=60
RATE_LIMIT_SENSITIVE_LIMIT=10
RATE_LIMIT_SENSITIVE_WINDOW_SECONDS=60
